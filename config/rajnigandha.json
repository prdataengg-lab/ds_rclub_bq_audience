{
  "ga4": {
    "measurement_id": "G-QMH9CNVQGE",
    "api_secret_name": "projects/970164980416/locations/asia-south2/secrets/rajnigadha-api-sceret-audience/latest",
    "endpoint": "https://www.google-analytics.com/mp/collect"
  },
  "bigquery": {
    "project": "dsgroup-havas-csa",
    "query": [
      "WITH base AS (",
      "    SELECT",
      "        ds_group_user_id,",
      "        user_pseudo_id",
      "    FROM `dsgroup-havas-csa.ga4_silver.slv_events_flat`",
      "    WHERE stream_id = @stream_id",
      "      AND event_date >= @event_date_from",
      "      AND user_pseudo_id IS NOT NULL",
      "      AND ds_group_user_id IS NOT NULL",
      "      AND LOWER(operating_system) = @operating_system",
      "      AND LOWER(browser) = @browser",
      "    GROUP BY 1, 2",
      "),",
      "final_view AS (",
      "    SELECT DISTINCT",
      "        ds_group_user_id,",
      "        user_pseudo_id,",
      "        @event_name AS event_name",
      "    FROM base",
      "    LIMIT @row_limit",
      ")",
      "SELECT * FROM final_view"
    ],
    "query_params": {
      "stream_id": "13077205318",
      "event_date_from": "2025-12-01",
      "operating_system": "windows",
      "browser": "edge",
      "row_limit": 100
    }
  },
  "event": {
    "name": "Rajnigandha-windows-edge-test",
    "engagement_time_msec": 100
  },
  "run": {
    "throttle_seconds": 0.05,
    "request_timeout_seconds": 10,
    "log_level": "INFO"
  }
}